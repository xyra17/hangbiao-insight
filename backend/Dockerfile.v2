FROM python:3.13-slim

RUN addgroup --system insight && adduser --system --ingroup insight insight

WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock /app/backend/
RUN pip install --no-cache-dir uv && cd /app/backend && uv sync --frozen --no-dev
COPY --chown=insight:insight backend /app/backend
COPY --chown=insight:insight dataset/data/03_黄金评论集/主题分类体系_v1_1.json /app/dataset/data/03_黄金评论集/主题分类体系_v1_1.json
RUN mkdir -p /data/storage && chown -R insight:insight /data /app
WORKDIR /app/backend
ENV PATH="/app/backend/.venv/bin:$PATH"
ENV PYTHONPATH=/app/backend DJANGO_SETTINGS_MODULE=config.settings
USER insight
EXPOSE 8000
CMD ["/app/backend/.venv/bin/gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "120"]
