# Required by the Django/PostgreSQL/Celery development runtime. Use local-only
# values in the repository-root .env.local file; do not commit that file.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
INSIGHT_DB_PASSWORD=replace-with-a-local-database-password
INSIGHT_REDIS_PASSWORD=replace-with-a-local-redis-password
PGHOST=127.0.0.1
PGPORT=55433
PGDATABASE=insight_dev
PGUSER=insight
REDIS_PORT=56380
CELERY_BROKER_URL=redis://:replace-with-a-local-redis-password@127.0.0.1:56380/0

# Frozen Stage 5.5A semantic model selection. Never commit a real key.
SEMANTIC_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# Optional local development fallback.
LM_STUDIO_API_KEY=local-no-auth

# Stage 6A investigation runtime limits (seconds)
PLANNER_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=30
INVESTIGATION_TIMEOUT_SECONDS=180
PLANNER_MAX_RETRIES=0
INVESTIGATION_POLL_INTERVAL_SECONDS=0.25

# Candidate relevance: disabled until provider, region, transmission and budget approval.
EVIDENCE_RELEVANCE_ENABLED=0
EVIDENCE_RELEVANCE_PROVIDER=deepseek
EVIDENCE_RELEVANCE_APPROVAL_REFERENCE=
EVIDENCE_RELEVANCE_REGION=
EVIDENCE_RELEVANCE_MAX_CANDIDATES=20
EVIDENCE_RELEVANCE_MAX_REQUEST_BYTES=12000
EVIDENCE_RELEVANCE_MAX_OUTPUT_TOKENS=3000
EVIDENCE_RELEVANCE_MAX_COST=0.02
EVIDENCE_RELEVANCE_TIMEOUT_SECONDS=10
# Set approved provider prices per million tokens; blank blocks dispatch.
INVESTIGATION_INPUT_COST_PER_MILLION=
INVESTIGATION_OUTPUT_COST_PER_MILLION=
# Include deepseek only after approval; never commit provider keys.
INSIGHT_ENABLED_MODEL_PROVIDERS=

# Planner transmission/region approval; no runtime approval is inferred from enabled provider.
INVESTIGATION_APPROVAL_REFERENCE=
INVESTIGATION_REGION=

# Numeric approval limits: same provider quote currency; absent means external eval is blocked.
INVESTIGATION_COST_CURRENCY=
# Planner full wire limit: default 12000, configurable up to 65536.
# Higher limits require matching call/run/eval cost ceilings and fresh paid approval.
INVESTIGATION_MAX_REQUEST_BYTES=12000
INVESTIGATION_MAX_OUTPUT_TOKENS=3000
INVESTIGATION_MAX_CALL_COST=
INVESTIGATION_MAX_RUN_COST=
INVESTIGATION_MAX_EVAL_COST=

# Semantic provider calls also require a finite request/output/cost envelope.
SEMANTIC_MAX_REQUEST_BYTES=12000
SEMANTIC_MAX_OUTPUT_TOKENS=
SEMANTIC_MAX_CALL_COST=

# API aliases are not immutable model versions. Actual response.model/id are logged.
INVESTIGATION_MODEL=deepseek-flash
EVIDENCE_RELEVANCE_MODEL=deepseek-flash
SEMANTIC_MODEL=deepseek-flash
