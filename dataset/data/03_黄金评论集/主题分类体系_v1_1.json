{
  "version": "taxonomy-v1.1",
  "status": "frozen",
  "based_on": "taxonomy-v1.0",
  "adopted_changes": [
    {
      "path": "function_performance / power_output",
      "type": "add_subtopic",
      "reason": "Repeated reviews explicitly discuss insufficient/sufficient power, current, or amperage."
    },
    {
      "path": "reliability_durability / general_durability",
      "type": "add_subtopic",
      "reason": "Repeated reviews explicitly praise durability, long life, or long-term stable use."
    },
    {
      "path": "compatibility_fit / accessory_compatibility",
      "type": "add_subtopic",
      "reason": "Non-case accessories such as Pop Socket can affect wireless charging compatibility."
    },
    {
      "path": "safety_risk / electrical_fault",
      "type": "add_subtopic",
      "reason": "Short circuit and partial home power outage are distinct electrical safety signals."
    },
    {
      "path": "safety_risk / device_damage",
      "type": "add_subtopic",
      "reason": "One review explicitly alleges battery/device damage caused by the charger."
    },
    {
      "path": "product_quality / accessory_condition",
      "type": "extend_definition",
      "reason": "Includes missing expected accessories such as a wall plug/power adapter."
    }
  ],
  "deferred_gaps": [
    {
      "candidate": "function_performance / charge_control",
      "decision": "defer",
      "reason": "Only one explicit auto-stop/100% charging-control example; keep general_performance for now."
    },
    {
      "candidate": "product_quality / packaging_usability",
      "decision": "defer",
      "reason": "Low frequency and lower relevance to P0 operating diagnosis."
    },
    {
      "candidate": "appearance_aesthetics",
      "decision": "defer",
